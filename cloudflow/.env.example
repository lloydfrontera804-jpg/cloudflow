# From MongoDB Atlas: Database > Connect > Drivers > copy the connection
# string, then fill in the password you set for the database user and add
# a database name in the path (e.g. /remotevm) if it's not already there.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/remotevm?retryWrites=true&w=majority

# Exact URL of your deployed frontend (Render), used for CORS.
# Use "*" only for local testing — restrict it once you have the real URL.
FRONTEND_ORIGIN=https://your-frontend.onrender.com

# Shared secret the laptop's tunnel-reporting script must send to update
# the current VNC tunnel hostname. Generate a random string for this.
TUNNEL_REPORT_KEY=change-me-to-a-random-string

# Set by Render automatically; set to "production" only when actually deployed.
NODE_ENV=development

PORT=4000
